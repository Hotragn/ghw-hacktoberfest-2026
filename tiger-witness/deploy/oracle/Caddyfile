{$WITNESS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# webhooks + app + API all go to the FastAPI service; it acks webhooks immediately and enqueues work
	reverse_proxy 127.0.0.1:8103 {
		health_uri /healthz
	}
	request_body {
		max_size 2MB
	}
}
