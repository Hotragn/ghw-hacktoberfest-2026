# ======================================================================================================
# Witness on Oracle Always Free. Copy to .env (chmod 600). Every secret Witness can use is listed here.
# REQUIRED lines are marked [R]. Everything else is optional; a missing provider key just drops it from the pool.
# Users never configure anything: all model keys below are the OPERATOR's single account per provider.
# ======================================================================================================

# ---- core [R]
WITNESS_DOMAIN=witness.example.com          # [R] DNS A record -> the VM's public IP (Caddy gets the TLS cert)
ACME_EMAIL=you@example.com                  # [R] Let's Encrypt expiry notices
POSTGRES_PASSWORD=                          # [R] openssl rand -base64 32 | tr -d '/+='
WITNESS_SIGNING_KEY=                        # [R] openssl rand -hex 32   (>= 32 chars; signs receipts/sessions)
WITNESS_ENV=prod
WITNESS_COOKIE_SECURE=true
WITNESS_PUBLIC_URL=https://witness.example.com
WITNESS_RP_ID=witness.example.com           # passkeys: must equal your domain
WITNESS_ORIGIN=https://witness.example.com
WITNESS_REQUIRE_PASSKEY=true                # high-risk actions (payments, email) need a passkey
WITNESS_EMBEDDINGS=local
WITNESS_TZ=America/New_York                 # zone used in "Saved, I'll reply by ~HH:MM"

# ---- model pool (server-side, zero user setup). One account per provider (ToS).
GROQ_API_KEY=                               # [R in practice] console.groq.com -> API Keys. Primary pool.
# GROQ_MODEL_STRONG=openai/gpt-oss-120b  GROQ_MODEL_MAIN=qwen/qwen3.8-27b  GROQ_MODEL_LIGHT=openai/gpt-oss-20b
CLOUDFLARE_ACCOUNT_ID=                      # dash.cloudflare.com -> Workers AI -> account id
CLOUDFLARE_API_TOKEN=                       # token with "Workers AI: Read" (+ "Workers AI: Edit" not needed)
OPENROUTER_API_KEY=                         # openrouter.ai/keys (free models only; last-resort tail)
# OPENROUTER_FREE_MODELS=openai/gpt-oss-120b:free,qwen/qwen3-30b-a3b:free   OPENROUTER_RPD=50
GEMINI_API_KEY=                             # aistudio.google.com. Free tier trains on inputs:
WITNESS_GEMINI_OPT_IN=false                 #   only non-personal turns ever go there, and only if true + disclosed
NVIDIA_API_KEY=                             # build.nvidia.com: ToS = prototyping only. Keep false in production.
WITNESS_NVIDIA_ALLOW_PROTOTYPE=false
# Local llama.cpp is wired by docker-compose (WITNESS_LOCAL_LLM_URL=http://llm:8080/v1); nothing to set.

# ---- fairness / budgets
WITNESS_USER_DAILY_TOKENS=60000
WITNESS_USER_DAILY_REQUESTS=80
WITNESS_NEW_USER_RESERVE=0.15               # share of pooled daily tokens held for users < WITNESS_NEW_USER_DAYS old
WITNESS_NEW_USER_DAYS=3
WITNESS_DEFER_STAGGER_S=20                  # fair drain spacing between one user's queued turns
WITNESS_SEMANTIC_CACHE=true

# ---- channels (fill the ones you use)
TELEGRAM_BOT_TOKEN=                         # @BotFather
TELEGRAM_WEBHOOK_SECRET=                    # openssl rand -hex 24
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
IMESSAGE_BLUEBUBBLES_URL=
IMESSAGE_BLUEBUBBLES_PASSWORD=
IMESSAGE_WEBHOOK_SECRET=

# ---- payments (unset => simulated rail)
STRIPE_API_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=

# ---- tools
WITNESS_ALLOW_STDIO_MCP=false
WITNESS_ALLOW_PRIVATE_FETCH=false
