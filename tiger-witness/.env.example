# Get this with: tiger db uri   (append ?sslmode=require if missing)
TIGER_DB_URL=postgres://tsdbadmin:PASSWORD@SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# HMAC key for signing receipts (demo). Production: per-user Ed25519 key held on the user's device.
WITNESS_SIGNING_KEY=change-me-demo-key
WITNESS_PORT=8103

# ---- v2 agent: LLM (any OpenAI-compatible endpoint). Unset => deterministic offline planner.
WITNESS_LLM_BASE_URL=
WITNESS_LLM_API_KEY=
WITNESS_LLM_MODEL=gpt-4o-mini
# ---- payments: unset => mock rail. Stripe charges a saved payment method off_session.
STRIPE_API_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=
# WITNESS_AGENT_KEY_PEM=   # optional ES256 agent key (default: derived from WITNESS_SIGNING_KEY)
# ---- channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# iMessage needs a Mac running BlueBubbles Server (no public Apple API)
IMESSAGE_BLUEBUBBLES_URL=
IMESSAGE_BLUEBUBBLES_PASSWORD=
IMESSAGE_WEBHOOK_SECRET=
# ---- tools
WITNESS_FILES_ROOT=/tmp/witness-files
WITNESS_ALLOW_STDIO_MCP=false
WITNESS_ALLOW_PRIVATE_FETCH=false
# ---- v3: embeddings (default: local open-source all-MiniLM-L6-v2, 384-d; 'hashed' is test-only)
WITNESS_EMBEDDINGS=local
# WITNESS_EMBEDDINGS=openai  WITNESS_EMBED_API_KEY=  WITNESS_EMBED_MODEL=text-embedding-3-small  WITNESS_EMBED_DIM=
# after switching models: python -m witness.reembed
# ---- v3: passkeys (WebAuthn). RP ID = your domain; origin = exact https origin the browser loads.
WITNESS_RP_ID=localhost
WITNESS_ORIGIN=http://localhost:8103
WITNESS_REQUIRE_PASSKEY=false
WITNESS_PUBLIC_URL=http://localhost:8103
# ---- v3.1: zero-friction model router (server-side pooled free providers; see docs/ROUTER.md).
# Any of these turns the router on. Full annotated list: deploy/oracle/.env.example
# GROQ_API_KEY=  CLOUDFLARE_ACCOUNT_ID=  CLOUDFLARE_API_TOKEN=  OPENROUTER_API_KEY=
# GEMINI_API_KEY=  WITNESS_GEMINI_OPT_IN=false   NVIDIA_API_KEY=  WITNESS_NVIDIA_ALLOW_PROTOTYPE=false
# WITNESS_LOCAL_LLM_URL=http://localhost:8080/v1   WITNESS_TZ=UTC   WITNESS_ROUTER=auto
