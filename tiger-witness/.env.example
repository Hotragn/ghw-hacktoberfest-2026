# Get this with: tiger db uri   (append ?sslmode=require if missing)
TIGER_DB_URL=postgres://tsdbadmin:PASSWORD@SERVICE.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# HMAC key for signing receipts (demo). Production: per-user Ed25519 key held on the user's device.
WITNESS_SIGNING_KEY=change-me-demo-key
WITNESS_PORT=8103
