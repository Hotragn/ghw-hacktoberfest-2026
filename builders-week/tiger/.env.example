# Copy to .env locally — NEVER commit .env or passwords.
#
# Tiger Cloud service name or ID (from: tiger service list)
TIGER_SERVICE_NAME=your-service-name
#
# Optional: full URL if you prefer psql instead of Tiger CLI
# Get with: tiger db uri "$TIGER_SERVICE_NAME" --with-password
# TIGER_DB_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
